# Synthetic development/demo configuration. Copy to .env and replace the JWT secret.
CHIATRATON_ENVIRONMENT=development
CHIATRATON_DEBUG=false
CHIATRATON_DOCS_ENABLED=true
CHIATRATON_JWT_SECRET=replace-with-a-random-development-secret
CHIATRATON_JWT_ALGORITHM=HS256
CHIATRATON_IDEMPOTENCY_BACKEND=memory
CHIATRATON_REPOSITORY_BACKEND=memory
CHIATRATON_DOCUMENT_STORAGE_BACKEND=memory
CHIATRATON_CRITERION_EXTRACTOR_BACKEND=fake
CHIATRATON_REPORT_ANALYZER_BACKEND=fake
CHIATRATON_JOB_RUNNER_BACKEND=local

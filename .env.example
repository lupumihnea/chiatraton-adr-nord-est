# Shared SQLite database. Point this to your existing adr_rag.db if desired.
ADR_DB_PATH=documents.db
DATABASE_URL=sqlite:///documents.db

# Paid-only OpenRouter model.
OPENROUTER_API_KEY=replace_me
OPENROUTER_PAID_MODEL=qwen/qwen3-235b-a22b-2507
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Local embeddings.
LOCAL_EMBEDDING_MODEL=intfloat/multilingual-e5-small

# Optional retrieval controls.
PROJECT_MAX_CHUNKS_PER_DOCUMENT=32
GENERIC_MAX_CANDIDATE_CHUNKS=40
GROQ_BATCH_SIZE=4
APPLICABILITY_BATCH_SIZE=3

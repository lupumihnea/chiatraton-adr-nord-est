# Synthetic development/demo configuration. Copy to .env and replace secrets.
CHIATRATON_ENVIRONMENT=development
CHIATRATON_DEBUG=false
CHIATRATON_DOCS_ENABLED=true
CHIATRATON_JWT_SECRET=replace-with-a-random-development-secret
CHIATRATON_JWT_ALGORITHM=HS256
CHIATRATON_IDEMPOTENCY_BACKEND=memory
CHIATRATON_REPOSITORY_BACKEND=memory
CHIATRATON_DOCUMENT_STORAGE_BACKEND=memory
CHIATRATON_CRITERION_EXTRACTOR_BACKEND=qwen
CHIATRATON_REPORT_ANALYZER_BACKEND=qwen
CHIATRATON_JOB_RUNNER_BACKEND=local
CHIATRATON_API_BASE_URL=http://127.0.0.1:8000
CHIATRATON_UI_BEARER_TOKEN=replace-with-a-local-development-token
CHIATRATON_UI_HOST=127.0.0.1
CHIATRATON_UI_PORT=8081
# UI-only preview: explainable extraction confidence and page-local expert profile.
CHIATRATON_DEMO_EXPERT_PROFILE=true

# AIClient / Qwen configuration (paid OpenRouter route; never commit the real key)
AI_PROVIDER=qwen
AI_MODEL_NAME=qwen/qwen3-235b-a22b-2507
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=
AI_TIMEOUT_SECONDS=180
AI_CONTRACT_VERSION=1.0
LOCAL_EMBEDDING_MODEL=intfloat/multilingual-e5-small
OPENROUTER_APP_NAME=ChIAtraton

# Legacy AI prototype configuration imported from main; not used by app/ or Interface/.
ADR_DB_PATH=documents.db
DATABASE_URL=sqlite:///documents.db
OPENROUTER_API_KEY=replace_me
OPENROUTER_PAID_MODEL=qwen/qwen3-235b-a22b-2507
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
PROJECT_MAX_CHUNKS_PER_DOCUMENT=32
GENERIC_MAX_CANDIDATE_CHUNKS=40
GROQ_BATCH_SIZE=4
APPLICABILITY_BATCH_SIZE=3
